# Copy this file to .env and fill in the values. Never commit .env.

# Always required. 64 random hex characters, e.g. from:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace-with-64-random-hex-characters
DATABASE_URL=sqlite:///./bodyshop.db
# Must be true before a shop can switch to LIVE mode.
ALLOW_LIVE_SMS=false
# Tests set this to false and call run_sender(now) directly.
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# LIVE mode only
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
PUBLIC_BASE_URL=https://shop.example.com

# Hosting with docker compose only (see README "Hosting")
# DATABASE_URL is set by docker-compose.yml to the bundled Postgres; PUBLIC_BASE_URL becomes https://$DOMAIN.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DOMAIN=shop.example.com
BACKUP_KEEP_DAYS=14
BACKUP_TIME_UTC=10:15
